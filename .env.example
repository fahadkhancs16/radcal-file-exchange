APP_NAME="Radcal File Exchange"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Must match how you actually reach the app, or Livewire's JS/upload
# endpoints resolve to the wrong host. `php artisan serve` -> http://127.0.0.1:8000
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=radcal_share
DB_USERNAME=root
DB_PASSWORD=
# XAMPP ships MariaDB 10.4 — use a collation it supports.
# On MySQL 8 you can drop these two lines.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
# Local: leave MAIL_MAILER=log and read codes from storage/logs/laravel.log.
# Staging/production: Brevo (SMTP shown; API transport also fine).
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@radcal.com"
MAIL_FROM_NAME="Radcal File Exchange"
# Replies to the no-reply sender land here (a monitored Radcal mailbox). Leave blank for none.
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="Radcal"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Staff-access user manager ---
# A private, unlinked page for creating/editing/deleting Radcal staff
# accounts, gated by this single shared password instead of a login — the
# recovery path if every admin password is lost. Generate real random values
# per deployment (e.g. `php -r "echo bin2hex(random_bytes(16));"`) and never
# commit real ones. Leave ADMIN_MANAGER_PASSWORD blank to disable the page.
ADMIN_MANAGER_PATH=change-me-to-a-random-string
ADMIN_MANAGER_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# --- File Exchange settings (see config/exchange.php; spec §15) ---
EXCHANGE_STORAGE_DISK=exchanges
EXCHANGE_DEFAULT_MAX_BYTES=209715200      # 200 MB per file
EXCHANGE_MAX_ALLOWED_BYTES=2147483648     # ceiling an admin may raise a single exchange to
EXCHANGE_LIFETIME_DAYS=14
EXCHANGE_CODE_LENGTH=8
EXCHANGE_PASSWORD_LENGTH=12
EXCHANGE_EXPIRING_SOON_DAYS=2
# Who gets emailed when a customer uploads a file. Comma-separated for
# multiple addresses; leave blank to notify every is_admin=true user instead.
EXCHANGE_STAFF_NOTIFICATION_EMAIL=
VERIFICATION_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_SECONDS=60
